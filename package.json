{
  "name": "agentos-travel-poc",
  "private": true,
  "version": "0.1.0",
  "description": "Template repo for an AI-assisted travel booking PoC using Airwallex payment links.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:all": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
